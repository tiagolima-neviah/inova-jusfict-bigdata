# Copie para .env e preencha. O .env nunca entra no git.

# Produção da plataforma: o Postgres do inova-jusfict-app (Neon, schema inova).
# É a MESMA string que está em DATABASE_URL no .env do app: a conexão direta,
# sem -pooler. O gerador grava aqui; o pipeline só lê.
PLATAFORMA_URL=postgresql://usuario:senha@host-do-neon/jusfict_inova

# Staging: o Postgres local do docker-compose.yml deste repositório.
# Não precisa mudar; o pipeline sobe o container sozinho se ele estiver parado.
STAGING_URL=postgresql://staging:staging@localhost:5433/jusfict_staging

# Warehouse: schema dw. Na demo é o mesmo banco da produção (ADR 0002), então
# repita a string de PLATAFORMA_URL. Em branco, o pipeline usa PLATAFORMA_URL.
DW_NEON_URL=

# Onde ficam as camadas de arquivo (bronze, silver, gold). Em branco, usa a
# pasta lake/ na raiz do repositório, que está fora do git.
LAKE_DIR=

# Têmis (pareceres em lote): chave da API da Anthropic, criada em console.anthropic.com.
# Sem ela o pipeline roda igual, só não emite pareceres novos.
ANTHROPIC_API_KEY=

# Opcionais da Têmis: o modelo e quantas inovações novas a etapa do pipeline avalia sozinha.
TEMIS_MODELO=
TEMIS_LIMITE_NO_PIPELINE=
