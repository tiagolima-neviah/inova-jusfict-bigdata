# Copie para .env e preencha. O .env nunca entra no git.

# Produção da plataforma: Neon, schema inova (papel do Oracle do case; ADRs 0001 e 0003)
# Extração usa o endpoint direto, sem -pooler. Local em desenvolvimento.
PLATAFORMA_URL=postgresql://usuario:senha@localhost:5432/jusfict_inova

# Staging local na WSL (réplica D-1 extraída do Neon)
STAGING_URL=postgresql://usuario:senha@localhost:5433/jusfict_staging

# Warehouse local de desenvolvimento
DW_URL=postgresql://usuario:senha@localhost:5434/jusfict_dw

# Warehouse no Neon: mesmo projeto, schema dw (sem -pooler para carga, com -pooler para consulta)
DW_NEON_URL=

# Raiz do lake (fsspec: file:// local, s3:// se um dia for para a nuvem)
LAKE_URL=file:///home/neviah/dados/inova-jusfict
